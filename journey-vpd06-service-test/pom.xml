<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uk.gov.hmrc.eis.tests</groupId>
        <artifactId>bdd-test-parent</artifactId>
        <version>2.0.1</version>
        <!-- Empty relative path required so that default parent is ignored -->
        <relativePath/>
    </parent>

    <artifactId>journey-vpd06-service-test</artifactId>
    <packaging>jar</packaging>

    <properties>
        <spring-boot.version>2.7.12</spring-boot.version>
    </properties>

    <profiles>
        <profile>
            <id>intellij</id>
            <activation>
                <property>
                    <name>intellij</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <testFailureIgnore>true</testFailureIgnore>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>uk.gov.hmrc.eis.tests</groupId>
            <artifactId>bdd-test-core</artifactId>
            <version>2.3.0</version>
        </dependency>
        <dependency>
            <groupId>uk.gov.hmrc.eis.tests</groupId>
            <artifactId>bdd-test-wiremock</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- These parameters are for customised reporting that generates as an attachment after each scenario-->
                <configuration>
                    <systemPropertyVariables>
                        <journeyName>vpd06</journeyName>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- this plugin is for cucumber reporting that shows a pie chart with variations like features, failures etc -->
            <plugin>
                <groupId>net.masterthought</groupId>
                <artifactId>maven-cucumber-reporting</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
